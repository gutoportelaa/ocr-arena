# Exemplo de arquivo .env
# Renomeie para .env e preencha com suas credenciais e configurações

# Ollama
OLLAMA_HOST=http://localhost:11434

# Tesseract
TESSERACT_PATH=/usr/bin/tesseract

# Docling (se aplicável)
DOCLING_API_KEY=your_docling_api_key
DOCLING_ENDPOINT=https://api.docling.com

# Marker (se aplicável)
MARKER_MODEL_PATH=/path/to/marker/model

# Configurações gerais
LOG_LEVEL=INFO
DATA_DIR=./data
OUTPUT_DIR=./outputs
REPORTS_DIR=./reports
